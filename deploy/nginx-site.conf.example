# Bloque de Nginx para servir la demo detrás de un Nginx existente (con certbot por webroot).
# Reemplazar DEMO_DOMAIN por el subdominio y agregarlo también al server_name del bloque del
# puerto 80 que atiende /.well-known/acme-challenge/ y redirige a https.

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name DEMO_DOMAIN;
    ssl_certificate     /etc/letsencrypt/live/edqs.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/edqs.online/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # El chat responde por Server-Sent Events: sin buffering ni compresión, o los eventos
    # llegan todos juntos al final en lugar de en vivo
    location / {
        resolver 127.0.0.11 valid=10s;
        set $upstream http://banking-demo:7860;
        proxy_pass $upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 120s;
        client_max_body_size 64k;
    }
}
