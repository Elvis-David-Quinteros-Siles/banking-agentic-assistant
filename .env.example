# Copiar a .env y ajustar. Ninguna variable es obligatoria en la Fase 1.

APP_ENV=dev
LOG_LEVEL=INFO

# Proveedor del LLM base: fake | openai | anthropic | ollama  (se usa desde la Fase 2)
LLM_PROVIDER=fake
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Backend del router: rules | llm | lora
ROUTER_BACKEND=rules
# Umbral de confianza por debajo del cual se pide aclaración (Fase 2)
ROUTER_MIN_CONFIDENCE=0.6
