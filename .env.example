# Copiar a .env y ajustar:  Copy-Item .env.example .env
# Sin .env el sistema corre en modo "fake" (determinista, sin LLM), igual que en CI.

APP_ENV=dev
LOG_LEVEL=INFO

# --- LLM base: fake | ollama | openai | anthropic -------------------------
# Recomendado para la demo: ollama (on-premise, los datos no salen de la máquina)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=512

# Opcionales (proveedores cloud)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Router: rules | llm | lora (lora llega en la Fase 4) -----------------
ROUTER_BACKEND=llm
ROUTER_MIN_CONFIDENCE=0.6

# --- Agentes --------------------------------------------------------------
REACT_MAX_ITERATIONS=4
KNOWLEDGE_BACKEND=keyword
KNOWLEDGE_TOP_K=4
KNOWLEDGE_MIN_SCORE=0.15
COMPLAINT_HIGH_PRIORITY_AMOUNT=1000
