# Copiar a .env y ajustar:  Copy-Item .env.example .env
# Sin .env el sistema corre en modo "fake" (determinista, sin LLM), igual que en CI.

APP_ENV=dev
LOG_LEVEL=INFO

# --- LLM base: fake | ollama | openai | anthropic -------------------------
# Recomendado para la demo: ollama (on-premise, los datos no salen de la máquina)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=512

# Opcionales (proveedores cloud)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Router: rules | llm | lora --------------------------------------------
# lora requiere: pip install -r finetune/requirements.txt + python finetune/train_lora.py
ROUTER_BACKEND=lora
ROUTER_MIN_CONFIDENCE=0.6
LORA_BASE_MODEL=Qwen/Qwen2.5-0.5B-Instruct
LORA_DEVICE=auto
# Nota: HF_HUB_OFFLINE=1 evita consultas a Hugging Face en cada arranque, pero debe ser variable
# de entorno del proceso ($env:HF_HUB_OFFLINE="1"); este .env solo lo lee la configuración de la app.

# --- Agentes --------------------------------------------------------------
REACT_MAX_ITERATIONS=4
COMPLAINT_HIGH_PRIORITY_AMOUNT=1000

# --- Conocimiento: keyword (BM25 en memoria) | neo4j (Graph RAG híbrido) ---
KNOWLEDGE_BACKEND=neo4j
KNOWLEDGE_TOP_K=4
KNOWLEDGE_MIN_SCORE=0.15

# --- Neo4j (docker compose up -d neo4j) -----------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=bankdemo123
EMBEDDINGS_BACKEND=fastembed
EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
NEO4J_MIN_SIMILARITY=0.65
RRF_K=60
